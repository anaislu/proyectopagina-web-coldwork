# Copiar a .env (ignorado por git). NUNCA commitear .env ni secrets/.
# Solo valores PÚBLICOS aquí: la publishable/anon key está diseñada para exponerse
# y su seguridad depende de RLS. La secret/service_role key NO se usa en runtime.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_HOST=<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Local con Supabase CLI (`supabase start`):
# SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_HOST=host.docker.internal:54321

WEB_PORT=8080
REGISTRY=ghcr.io/anaislu
TAG=latest
